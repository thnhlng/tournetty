@startuml tournetty-use-cases
' Use-Case-Diagramm Tournetty (UML 2.5)
' Quelle: docs/requirements.md FR-001..FR-026, docs/vision.md, docs/SPEC.md §4-§5
' Rendern: plantuml docs/use-cases/use-case-diagram.puml

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Organisator:in" as ORG
actor "Vorort-Mitarbeitende" as STAFF
actor "Teamverantwortliche:r" as TEAM
actor "Publikum" as PUBLIC

actor "LLM-Provider" as LLM <<external system>>

rectangle Tournetty {

  ' --- Stammdaten und Konfiguration (FR-1, FR-024) ---
  usecase "UC-001\nTurnier verwalten" as UC001
  usecase "UC-002\nTeams verwalten" as UC002
  usecase "UC-003\nGruppen verwalten" as UC003
  usecase "UC-004\nSpielfelder verwalten" as UC004
  usecase "UC-005\nTurnierregeln konfigurieren" as UC005

  ' --- Planung (FR-2, FR-3, FR-5) ---
  usecase "UC-006\nPhasen planen" as UC006
  usecase "UC-007\nSpielplan generieren" as UC007
  usecase "UC-008\nSpiele verschieben" as UC008
  usecase "UC-021\nSpiele auf Felder verteilen" as UC021
  usecase "UC-022\nInvariante «ein Team, ein Slot» prüfen" as UC022

  ' --- Anmeldung (FR-7) ---
  usecase "UC-009\nTeam anmelden" as UC009
  usecase "UC-010\nAnmeldung annehmen\noder ablehnen" as UC010
  usecase "UC-020\nAnmeldedaten serverseitig\nvalidieren" as UC020

  ' --- Durchführung und Zählen (FR-4) ---
  usecase "UC-011\nErgebnis erfassen" as UC011
  usecase "UC-023\nTabelle berechnen" as UC023
  usecase "UC-024\nSieger in nächste\nK.-o.-Runde weiterleiten" as UC024

  ' --- KI mit HITL-Gate (FR-019..FR-023, ADR-5) ---
  usecase "UC-012\nKI-Vorschlag Gruppenaufteilung\nanfordern" as UC012
  usecase "UC-013\nKI-Vorschlag Umplanung\nanfordern" as UC013
  usecase "UC-014\nVorschlag freigeben\noder verwerfen" as UC014
  usecase "UC-015\nProtokoll einsehen" as UC015
  usecase "UC-025\nModellantwort gegen Schema\nund Regeln prüfen" as UC025
  usecase "UC-026\nVorschlag mit Begründung\nanzeigen" as UC026
  usecase "UC-027\nEntscheid append-only\nprotokollieren" as UC027
  usecase "UC-028\nRegelbasierten Rückfall-\nvorschlag erzeugen" as UC028

  ' --- Sichten und Zugang (FR-6, FR-025, FR-026) ---
  usecase "UC-016\nÖffentliches Dashboard ansehen" as UC016
  usecase "UC-017\nAdministrations-Dashboard öffnen" as UC017
  usecase "UC-018\nSpiele filtern" as UC018
  usecase "UC-019\nAm System anmelden" as UC019
}

' --- Akteur-Zuordnung ---
ORG --> UC001
ORG --> UC002
ORG --> UC003
ORG --> UC004
ORG --> UC005
ORG --> UC006
ORG --> UC007
ORG --> UC008
ORG --> UC010
ORG --> UC011
ORG --> UC012
ORG --> UC013
ORG --> UC014
ORG --> UC015
ORG --> UC017
ORG --> UC019

STAFF --> UC011
STAFF --> UC018
STAFF --> UC019

TEAM --> UC009
TEAM --> UC016

PUBLIC --> UC016

' --- Sekundärakteur: genau ein Ausgang nach aussen (ADR-2) ---
UC012 --> LLM
UC013 --> LLM

' --- include ---
UC009 ..> UC020 : <<include>>
UC007 ..> UC021 : <<include>>
UC007 ..> UC022 : <<include>>
UC008 ..> UC022 : <<include>>
UC011 ..> UC023 : <<include>>
UC011 ..> UC024 : <<include>>
UC012 ..> UC025 : <<include>>
UC013 ..> UC025 : <<include>>
UC012 ..> UC026 : <<include>>
UC013 ..> UC026 : <<include>>
UC014 ..> UC027 : <<include>>
UC010 ..> UC002 : <<include>>

' --- extend ---
UC013 ..> UC002 : <<extend>>\nTeam fällt aus
UC028 ..> UC013 : <<extend>>\nLLM nicht erreichbar
UC014 ..> UC007 : <<extend>>\nnur nach Freigabe

note bottom of UC014
  ADR-5 / NFR-013: kein Vorschlag
  verändert Daten vor der Annahme
  durch einen Menschen.
end note

note bottom of UC020
  NFR-015: Anmeldung ist der einzige
  unauthentifizierte Schreib-Endpunkt;
  Browser-Validierung zählt nicht.
end note

note right of UC007
  ADR-3: deterministisch und
  regelbasiert — nicht durch die KI.
end note

@enduml
